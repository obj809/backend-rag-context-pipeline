# Copy to .env and fill in. The backend reads its own .env first, then falls back
# to the umbrella project's .env during the multi-repo split.

# Direct OpenAI: a real OpenAI key, and leave OPENAI_BASE_URL unset.
# Via the LiteLLM proxy: OPENAI_API_KEY is a LiteLLM virtual key, and set
# OPENAI_BASE_URL (host/local dev below; the Docker container gets it from compose).
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:4000/v1
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Optional shared-secret gate for /ask + /chat. Set it (production / public deploy)
# and every request must send `X-API-Key: <value>`; unset = keyless local dev.
# When set it also hides /docs, /redoc, /openapi.json. compose interpolates it.
# RAG_API_KEY=change-me
